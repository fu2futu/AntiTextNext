# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# Get these values from your Supabase project settings:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project (or create a new one)
# 3. Go to Settings > API
# 4. Copy the Project URL and anon/public key below

NEXT_PUBLIC_SUPABASE_URL=https://your-actual-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-actual-long-key
NEXT_PUBLIC_APP_URL=https://textnext.jp
# Capacitor native app wrapper. Public app URL loaded inside iOS/Android WebView.
# Leave unset for production default: https://textnext.jp
# CAPACITOR_SERVER_URL=https://textnext.jp
# Server-side only. Required for server-side jobs such as email and Web Push delivery.
# SUPABASE_SERVICE_ROLE_KEY=
# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side only. Used by /api/books/isbn as a Google Books fallback.
# Do not expose this as NEXT_PUBLIC unless you intentionally want it in the browser bundle.
GOOGLE_BOOKS_API_KEY=AIzaSyDYZf72kP8CjxkF1a67YfQFWA2aegbsq1U

# Server-side only. Used by /api/library/search for university library availability.
# CALIL_APP_KEY=
# Set this to the Calil system id for the target university library.
# CALIL_SYSTEM_ID=TokyoTech

# Cloudflare R2
# Server-side only. Never expose access keys or secret keys as NEXT_PUBLIC_*.
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://img.textnext.jp
# R2_ENDPOINT=

# Public display-only URL base for client-side image URL construction.
# This is not a secret. Keep it equal to R2_PUBLIC_BASE_URL unless you intentionally use another public domain.
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://img.textnext.jp

# Admin protection
# Server-side only. Used by middleware for /admin Basic authentication.
# ADMIN_BASIC_USER=
# ADMIN_BASIC_PASSWORD=

# Stripe
# Server-side only. Never expose Stripe secret keys as NEXT_PUBLIC_*.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Web Push / PWA notifications
# Public VAPID key used by browser PushManager. This is not a secret.
# NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Server-side only. Keep private key out of NEXT_PUBLIC_* variables.
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_CONTACT=mailto:textnextbbs@gmail.com

# === Subject classification (syllabus DB) ===
# Server-side endpoint on the isct campus app that returns ISBN -> 学院/系 classification.
# Consumed by /api/subjects/sync. The key must match isct's SUBJECTS_API_KEY.
# ISCT_SUBJECTS_API_URL=https://<isct-host>/api/public/isbn-subjects
# ISCT_SUBJECTS_API_KEY=
